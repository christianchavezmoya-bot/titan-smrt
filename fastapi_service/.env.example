# Titan API Environment Configuration
# Copy this file to .env and update with your values

# API Settings
DEBUG=false
API_V1_PREFIX=/v1
PROJECT_NAME=Titan API
VERSION=1.0.0

# Security - CHANGE THESE IN PRODUCTION!
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
DATABASE_URL=postgresql://titan_user:titan_password@localhost:5432/titan_db

# CORS Origins (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173

# File Upload
MAX_UPLOAD_SIZE=52428800
UPLOAD_DIR=./uploads

# AI Service (optional, for future ML integration)
# AI_SERVICE_URL=https://your-ai-service.com
# AI_API_KEY=your-ai-api-key

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO
